<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>application-identifier</key>
    <string>com.openminis.app.broadfiles</string>
    <key>com.apple.security.application-groups</key>
    <array><string>group.com.openminis.app.broadfiles</string></array>
    <key>keychain-access-groups</key>
    <array><string>com.openminis.app.broadfiles</string></array>
    <key>get-task-allow</key>
    <false/>
    <!-- Native unsandboxing only: no persona-mgmt/root, TCC or process injection. -->
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <key>platform-application</key>
    <true/>
    <key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>
</dict>
</plist>
