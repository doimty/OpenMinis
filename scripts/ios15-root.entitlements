<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>application-identifier</key><string>com.openminis.app.root</string>
    <key>com.apple.security.application-groups</key><array><string>group.com.openminis.app.root</string></array>
    <key>keychain-access-groups</key><array><string>com.openminis.app.root</string></array>
    <key>get-task-allow</key><false/>
    <key>com.apple.private.security.no-sandbox</key><true/>
    <key>platform-application</key><true/>
    <key>com.apple.private.security.storage.AppDataContainers</key><true/>
    <key>com.apple.private.persona-mgmt</key><true/>
</dict></plist>
